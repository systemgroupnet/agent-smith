          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "WITH per_user AS (\n  SELECT\n    note_id,\n    user_id,\n    AVG(score) AS user_score\n  FROM\n    comment_scores\n  WHERE\n    $__timeFilter(received_at :: timestamptz)\n    AND project_path IN ($project)\n  GROUP BY\n    note_id,\n    user_id\n)\nSELECT\n  rc.project_path AS \"Project\",\n  'https://gitlab.example.com/' || rc.project_path || '/-/merge_requests/' || rc.mr_id || '#note_' || rc.note_id AS \"Link\",\n  -- rc.mr_id AS \"MR\",\n  rc.file AS \"File\",\n  rc.line AS \"Line\",\n  INITCAP(rc.severity) AS \"Severity\",\n  COUNT(*) AS \"Raters\",\n  AVG(pu.user_score) :: numeric(4, 2) AS \"Avg Rating\"\nFROM\n  per_user pu\n  JOIN review_comments rc ON rc.note_id = pu.note_id\nGROUP BY\n  rc.note_id,\n  rc.project_path,\n  rc.mr_id,\n  rc.file,\n  rc.line,\n  rc.severity\nORDER BY\n  \"Avg Rating\" ASC,\n  \"Raters\" DESC\nLIMIT\n  20;",
