          "rawSql": "SELECT\n  'https://gitlab.example.com/' || rs.project_path\n    || '/-/merge_requests/' || rs.mr_id || '#note_' || rs.note_id  AS \"Link\",\n  COALESCE(rs.model, '(unknown)')   AS \"Model\",\n  AVG(ss.score)::numeric(4,2)       AS \"Avg Rating\",\n  COUNT(DISTINCT ss.id)             AS \"Ratings\",\n  COUNT(DISTINCT cr.note_id)        AS \"Replies\",\n  rs.mr_author_username             AS \"MR Author\"\nFROM review_summaries rs\nLEFT JOIN summary_scores ss ON ss.note_id = rs.note_id\nLEFT JOIN comment_replies cr\n       ON cr.parent_note_id = rs.note_id AND cr.parent_kind = 'summary'\nWHERE rs.project_path IN ($project)\n  AND $__timeFilter(rs.received_at::timestamptz)\nGROUP BY rs.note_id, rs.project_path, rs.mr_id, rs.model, rs.mr_author_username\nORDER BY \"Avg Rating\" ASC NULLS LAST, \"Ratings\" DESC\nLIMIT 50;",
