          "format": "table",
          "rawQuery": true,
          "rawSql": "WITH replies AS (\n  SELECT cr.parent_note_id, cr.parent_kind, cr.author_username, cr.body,\n         COALESCE(NULLIF(cr.noted_at,'')::timestamptz, cr.received_at::timestamptz) AS reply_time\n  FROM comment_replies cr\n)\nSELECT\n  'https://gitlab.example.com/' || COALESCE(rc.project_path, rs.project_path)\n    || '/-/merge_requests/' || COALESCE(rc.mr_id, rs.mr_id)\n    || '#note_' || r.parent_note_id                    AS \"Link\",\n  INITCAP(COALESCE(r.parent_kind, 'finding'))          AS \"Kind\",\n  r.body                                               AS \"Reply\",\n  r.author_username                                    AS \"Replied by\"\nFROM replies r\nLEFT JOIN review_comments  rc ON rc.note_id = r.parent_note_id\nLEFT JOIN review_summaries rs ON rs.note_id = r.parent_note_id\nWHERE $__timeFilter(r.reply_time)\n  AND COALESCE(rc.project_path, rs.project_path) IN ($project)\nORDER BY r.reply_time DESC;",
          "refId": "A",
