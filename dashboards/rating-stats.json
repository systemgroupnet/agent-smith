          "rawSql": "SELECT\n  r.reviewer_version AS \"Version\",\n  ROUND(AVG(s.score) :: numeric, 2) AS \"Average Rating\",\n  COUNT(*) AS \"Ratings\",\n  COUNT(DISTINCT s.note_id) AS \"Comments Rated\",\n  COUNT(DISTINCT c.id) AS \"Comments Posted\"\nFROM\n  review_comments c\n  JOIN review_runs r ON r.id = c.review_run_id\n  LEFT JOIN comment_scores s ON s.note_id = c.note_id\nWHERE\n  r.project_path IN ($project)\n  AND $__timeFilter(r.timestamp :: timestamptz)\nGROUP BY\n  r.reviewer_version\nHAVING\n  COUNT(s.id) > 0\nORDER BY\n  lpad(\n    coalesce(\n      substring(\n        r.reviewer_version\n        from\n          '^v?(\\d+)'\n      ),\n      '0'\n    ),\n    5,\n    '0'\n  ) || lpad(\n    coalesce(\n      substring(\n        r.reviewer_version\n        from\n          '^v?\\d+\\.(\\d+)'\n      ),\n      '0'\n    ),\n    5,\n    '0'\n  ) || lpad(\n    coalesce(\n      substring(\n        r.reviewer_version\n        from\n          '^v?\\d+\\.\\d+\\.(\\d+)'\n      ),\n      '0'\n    ),\n    5,\n    '0'\n  ) DESC;",
          "refId": "A",
          "sql": {
            "columns": [
              {
                "parameters": [],
                "type": "function"
              }
            ],
            "groupBy": [
              {
                "property": {
                  "type": "string"
                },
                "type": "groupBy"
              }
            ],
            "limit": 50
          }
        }
