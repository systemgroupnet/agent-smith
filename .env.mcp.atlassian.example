# Copy to .env.mcp.atlassian and fill in. Configures the MCP server container, not the reviewer.
CONFLUENCE_URL=https://confluence.example.com/
CONFLUENCE_SSL_VERIFY=true
JIRA_URL=https://jira.example.com/
JIRA_SSL_VERIFY=true
ENABLED_TOOLS=confluence_search,confluence_get_page,confluence_get_page_children,confluence_get_comments,confluence_get_labels,confluence_search_user,jira_search,jira_get_issue,jira_get_all_projects,jira_get_project_issues,jira_get_worklog,jira_get_transitions,jira_search_fields,jira_get_agile_boards,jira_get_board_issues,jira_get_sprints_from_board,jira_get_sprint_issues,jira_get_issue_link_types
CONFLUENCE_PERSONAL_TOKEN=
JIRA_PERSONAL_TOKEN=
