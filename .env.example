# ============================================================================
# OpenRouter Configuration (Required for LLM access)
# ============================================================================

# OpenRouter API Key - Get yours at https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here

# OpenRouter Base URL (default: https://openrouter.ai/api/v1)
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Default LLM Model (uses OpenRouter format: provider/model-name)
# Examples:
#   - openai/gpt-4o-mini (fast, cost-effective)
#   - openai/gpt-4o (powerful, expensive)
#   - anthropic/claude-3-5-sonnet-20241022 (excellent reasoning)
#   - google/gemini-pro (Google's model)
#   - meta-llama/llama-3.1-70b-instruct (open source)
DEFAULT_LLM_MODEL=openai/gpt-4o-mini

# Fast model for simple tasks (e.g., classification)
FAST_LLM_MODEL=openai/gpt-4o-mini

# Smart model for complex reasoning tasks
SMART_LLM_MODEL=openai/gpt-4o

# ============================================================================
# Legacy OpenAI Configuration (still needed for translation function)
# ============================================================================

# OpenAI API Key (used for translation service only)
OPENAI_API_KEY=your_openai_api_key_here

# ============================================================================
# Proxy Configuration (Optional - for OpenAI API calls)
# ============================================================================

# Leave empty if not using a proxy
HTTP_PROXY=
HTTPS_PROXY=

# Proxy authentication (optional) - leave empty if proxy doesn't require auth
PROXY_USERNAME=
PROXY_PASSWORD=

# ============================================================================
# GitLab Configuration (Required for merge request reviews)
# ============================================================================

# GitLab instance URL
GITLAB_URL=https://gitlab.example.com

# GitLab Personal Access Token
GITLAB_TOKEN=your_gitlab_personal_access_token_here

# GitLab Project Path (e.g., "group/project")
GITLAB_PROJECT_PATH=your-group/your-project

# GitLab Domain (without protocol)
GITLAB_DOMAIN=gitlab.example.com

# ============================================================================
# Jira Configuration (Optional - for fetching task descriptions)
# ============================================================================

# Jira instance URL
JIRA_URL=https://jira.example.com

# Jira Personal Access Token
JIRA_PERSONAL_ACCESS_TOKEN=your_jira_personal_access_token_here

# Alternative: Jira Email and API Token (legacy)
JIRA_EMAIL=your.email@example.com
JIRA_API_TOKEN=your_jira_api_token_here

# ============================================================================
# Confluence Configuration (Optional - for fetching related documents)
# ============================================================================

# Confluence instance URL
CONFLUENCE_URL=https://confluence.example.com/

# Confluence Personal Access Token
CONFLUENCE_PERSONAL_ACCESS_TOKEN=your_confluence_personal_access_token_here

# ============================================================================
# MCP Atlassian Configuration (Optional - for Jira/Confluence integration)
# ============================================================================

# Enable MCP Atlassian integration
MCP_ATLASSIAN_ENABLED=true

# MCP server host
MCP_ATLASSIAN_HOST=localhost

# MCP server port
MCP_ATLASSIAN_PORT=3000

# Docker container name
MCP_ATLASSIAN_CONTAINER=mcp-atlassian

# SSH user for container access
MCP_ATLASSIAN_SSH_USER=root

# ============================================================================
# MCP GitLab Configuration (Required - uses MCP for all GitLab operations)
# ============================================================================

# Enable MCP GitLab integration
MCP_GITLAB_ENABLED=true

# GitLab MCP server host
MCP_GITLAB_HOST=localhost

# GitLab MCP container name
MCP_GITLAB_CONTAINER=mcp-gitlab

# SSH user for container access
MCP_GITLAB_SSH_USER=root

# ============================================================================
# Notes
# ============================================================================

# 1. Copy this file to .env and fill in your actual values
# 2. Never commit .env file to version control (it's in .gitignore)
# 3. OpenRouter supports 200+ models from various providers
# 4. You can switch models easily by changing DEFAULT_LLM_MODEL
# 5. OpenRouter handles rate limiting and fallbacks automatically
# 6. Check https://openrouter.ai/docs for model pricing and capabilities
