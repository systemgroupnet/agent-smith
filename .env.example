# Code Review Agent — environment template.
# Copy to .env and fill in. Everything without a value shown is optional and
# falls back to the default in the comment.
#
#   cp .env.example .env
#
# The MCP server containers are configured separately, in .env.mcp.gitlab and
# .env.mcp.atlassian.

# ── LLM provider (OpenRouter) ────────────────────────────────────────────────
# (Formerly OPENROUTER_API_KEY / OPENROUTER_BASE_URL / OPENROUTER_TIMEOUT_MS —
# the old names still work, with a deprecation warning.)
DEFAULT_LLM_API_KEY=
# OpenRouter model id, provider/model-name.
DEFAULT_LLM_MODEL=deepseek/deepseek-v4-pro
# Any OpenAI-compatible endpoint: OpenRouter, OpenRouter behind a reverse proxy,
# or a vendor's own API. Unset → api.openrouter.ai. The model id is whatever that
# endpoint calls it — "provider/model" on OpenRouter, native elsewhere (e.g.
# DEFAULT_LLM_BASE_URL=https://llm.example.com/v4 with DEFAULT_LLM_MODEL=glm-5.3).
DEFAULT_LLM_BASE_URL=
# JSON provider-routing config, e.g. {"order":["Anthropic"]} — the lever for
# OpenRouter "no endpoints match your data policy" 404s.
OPENROUTER_PROVIDER=
# Model-id prefixes whose thinking mode rejects a forced tool_choice; structured
# output disables reasoning for these only. Default: deepseek/
STRUCTURED_NO_REASONING_MODELS=

# How hard the model thinks, sent as reasoning.effort. Default: xhigh (one step
# below the most expensive setting there is; raise it to "max" if you want that).
# The ladder is none|minimal|low|medium|high|xhigh|max (OpenRouter's documented
# set; maximum/highest/full are spellings of max). Empty means xhigh, not off —
# say "provider" to send no reasoning field at all.
# A structured call to a model in STRUCTURED_NO_REASONING_MODELS still runs with
# reasoning off — that is a hard requirement of the forced tool_choice, not a
# preference.
LLM_REASONING_EFFORT=
# Per-request LLM timeout in ms. Default: 300000 (5 min).
LLM_TIMEOUT_MS=

# ── Fallback LLM provider (rate-limit failover) ──────────────────────────────
# When the primary answers with HTTP 429 for LLM_RETRY_ATTEMPTS in a row, the
# rest of the run switches to this provider. Any 429 counts, whoever the provider
# is — the numeric code in the body (z.ai's 1302 etc.) is logged but never
# interpreted, since those integers differ per provider. Set LLM_RETRY_ATTEMPTS=1
# to fail over on the very first 429 instead of retrying the primary.
# FALLBACK_LLM_MODEL is the switch: empty means no failover (the run fails).
FALLBACK_LLM_MODEL=
# Both default to the primary's value, so a fallback that is another model on the
# same account/endpoint needs only FALLBACK_LLM_MODEL; a genuinely separate
# provider needs all three.
FALLBACK_LLM_API_KEY=
FALLBACK_LLM_BASE_URL=

# ── GitLab ───────────────────────────────────────────────────────────────────
GITLAB_URL=
GITLAB_TOKEN=
# Comma-separated backoff (seconds) for retrying transient comment posts.
# Default: 1,2,5,10,30
GITLAB_COMMENT_RETRY_DELAYS=
# Label added to the MR once the review pass completes. Empty disables it.
# Default: ai-reviewed
MR_REVIEW_LABEL=
# Post a one-off "Review Summary" comment orienting the human reviewer (what the
# MR does, what changed, where to focus). Once per MR, gated on whether that
# comment already exists, so a first pass that died on a rate limit still gets
# one on the retry. Default: true
REVIEW_SUMMARY_ENABLED=
# Also write a short description of the MR into the MR description field, inside
# its own delimited block (replaced in place on a re-run, never touching the
# author's text). This is the summary's overview prose ONLY, plus an attribution
# line — what changed / where to focus / the effort estimate stay in the summary
# comment, since those brief a reviewer rather than describe the MR. The
# description is the only region that always renders above every comment, and
# GitLab has no way to pin a note. Set falsy to leave the description alone.
# Default: true
REVIEW_SUMMARY_IN_DESCRIPTION=

# ── MCP servers ──────────────────────────────────────────────────────────────
# The GitLab MCP server is optional and has no consumer in the review flow
# (GitLab is reached over its REST API). Leave off unless you add one.
MCP_GITLAB_ENABLED=false
MCP_GITLAB_URL=http://mcp-gitlab:3002
# streamable-http | sse. Default: streamable-http
MCP_GITLAB_TRANSPORT=

MCP_ATLASSIAN_ENABLED=false
MCP_ATLASSIAN_URL=http://mcp-atlassian:9000
MCP_ATLASSIAN_TRANSPORT=

# Per-MCP-tool-call timeout, seconds. Default: 60. A stalled call returns an
# "unavailable" observation instead of hanging the whole review.
MCP_TOOL_TIMEOUT_S=

# Credentials for the Atlassian MCP container (docker-compose passes these on).
JIRA_URL=
JIRA_PERSONAL_ACCESS_TOKEN=
CONFLUENCE_URL=
CONFLUENCE_PERSONAL_ACCESS_TOKEN=

# ── Review behaviour ─────────────────────────────────────────────────────────
# NOTE: there is no review-mode switch. The reviewer shallow-clones the MR's
# source branch and runs a deepagents orchestrator that delegates each file to its
# specialist reviewer subagent, which reads and greps the real checkout. This needs
# git in the image, and a run that cannot get a checkout fails rather than
# reviewing nothing. Any file the orchestrator skips is reviewed directly by the
# same specialist, so coverage never depends on a model's judgement.
# Wall-clock budget for the source-branch checkout, seconds. Default: 900.
# Measured on a 462 MiB monorepo: 403s over a WAN link (~190s of it the server
# sending ~40MiB, 3s writing 28k files) — it is download-bound, so a runner near
# GitLab is much faster. LFS is never fetched (203MiB avoided).
REPO_CLONE_TIMEOUT_S=
# Which files are reviewed and by which reviewer: a bundled profile name
# (reviewer/profiles/<name>.yml) or a path to your own YAML. Default: default.
# Left commented on purpose: an empty value would override the image's baked-in
# default (DEFAULT_REVIEW_PROFILE build arg) and silently select `default`.
# REVIEW_PROFILE=
# Comma-separated globs to skip, added to the profile's own `exclude`, e.g. *.md,docs/*
REVIEW_EXCLUDE_PATTERNS=
# Reviewer-file pairs reviewed at once. Default: 5. A ceiling held continuously,
# not a batch everything waits on: the pass pulls from a queue, so a worker that
# finishes takes the next file immediately. The name is historical.
FILE_BATCH_SIZE=
# Model calls one reviewer may spend on one file. Default: 50. Every tool round trip
# is one call, so a real investigation (find .aid, read the file, grep the callers)
# costs far more than it looks. Hitting the ceiling no longer loses the file — the
# reviewer is asked once to record what it already found.
REVIEWER_CALL_LIMIT=
# Set false to skip the service business-logic sub-reviewer. Default: true
BUSINESS_LOGIC_REVIEW_ENABLED=
# Set falsy to skip seeding the :one:–:five: rating reactions. Default: true
COMMENT_REACTIONS_ENABLED=
# Drop comments that repeat something already on the MR — a finding an earlier
# (incremental) run already posted, a point a human reviewer already made, or the
# same defect described twice in this batch. Runs last, against the MR's live
# comments, and only ever drops: it never edits a comment. Default: true
COMMENT_DEDUP_ENABLED=
# Set falsy to skip the "Review effort N/5" estimate + label. Default: true
EFFORT_ESTIMATE_ENABLED=
# Set false to silence the per-tool-call trace (one line per read_file/grep/glob/ls
# a reviewer makes, labelled with the reviewer and its file). Default: true
LOG_TOOL_TRACE=

# ── Timeouts and retries ─────────────────────────────────────────────────────
# Startup LLM ping budget, seconds. Default: 60
LLM_PREFLIGHT_TIMEOUT_S=
# Watchdog per file review, seconds. Default: 1200
FILE_REVIEW_TIMEOUT_S=
# Total review budget, seconds; remaining files are skipped past it. Default: 1500
OVERALL_TIMEOUT_S=
# Max attempts for transient LLM/gateway failures (per provider). Default: 3
LLM_RETRY_ATTEMPTS=
# Retries wait a random time in this range, seconds. Random rather than a fixed
# ladder because concurrent file reviews hit a rate limit together and a
# deterministic backoff makes them collide again. Defaults: 0.5 and 5.
LLM_RETRY_WAIT_MIN_S=
LLM_RETRY_WAIT_MAX_S=

# ── Run analytics (reviewer → collector) ─────────────────────────────────────
# Opt-in: off by default so a run never depends on the collector being up.
COLLECTOR_ENABLED=false
COLLECTOR_URL=http://collector:8000
# Optional shared secret, sent as X-Collector-Token.
COLLECTOR_TOKEN=
# Analytics POST timeout, seconds. Default: 3
COLLECTOR_TIMEOUT=

# ── Collector service (collector/ only) ──────────────────────────────────────
# Required by the collector. PostgreSQL only, no SQLite fallback.
COLLECTOR_DATABASE_URL=postgresql+psycopg://postgres:postgres@collector-db:5432/collector
# When set, POST /api/webhooks/gitlab requires a matching X-Gitlab-Token header.
GITLAB_WEBHOOK_SECRET=

# ── Weekly engagement digest (collector/digest.py + scheduler.py) ────────────
# Posts the closed ISO week's award winners, points table and newly unlocked
# badges to a Mattermost channel. **The collector schedules this itself** — a
# daemon thread inside the service, no host crontab. Setting the three
# MATTERMOST_* values below is all it takes to turn it on.
#
# MATTERMOST_TOKEN is a *write credential for the channel*: keep it out of git
# (this file is a template — put the real value in .env, which is ignored).
MATTERMOST_URL=https://mattermost.example.com
MATTERMOST_TOKEN=
# Channel id: Mattermost → Channel → View Info, or copy it out of the URL.
MATTERMOST_CHANNEL_ID=
# When the week's digest goes out, in DIGEST_TIMEZONE. Code defaults: mon 09:00 UTC.
# DIGEST_HOUR takes HH or HH:MM (DIGEST_MINUTE overrides the minute if you'd
# rather keep them apart).
#
# The week *reported* is always the ISO week before the one the firing moment
# falls in. ISO weeks end on Sunday midnight, so:
#   mon 11:45  → the week that closed the previous night   (1 day old)
#   sun 11:45  → the week before the one ending that night (7 days old)
# Monday is the setting that announces a week while it is still fresh.
DIGEST_DAY=sun
DIGEST_HOUR=12:00
DIGEST_MINUTE=
DIGEST_TIMEZONE=Asia/Tehran
# How often the thread checks whether a week is due. It is a ticker, not a timer:
# nothing is lost across a restart, and a service that was down at the firing
# moment posts as soon as it is back. Default 900 (15 min), floor 60.
DIGEST_TICK_S=
# Explicit off-switch. The credentials above are the opt-in, so an EMPTY value
# here means *enabled* — unlike the reviewer's flags, which read "" as off.
# Set false/0/no/off to keep the service from posting at all.
DIGEST_ENABLED=

# ── Tracing: Langfuse (prompt/context inspection) ────────────────────────────
# The base URI is the switch: set it, plus both keys, and tracing is on. Leave
# it unset for no tracing. Self-hosted, e.g. http://localhost:3000 — or
# https://cloud.langfuse.com for Langfuse Cloud. From inside docker-compose, a
# Langfuse published on the host machine is http://host.docker.internal:3000
LANGFUSE_BASE_URL=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# ── Misc ─────────────────────────────────────────────────────────────────────
# Corporate proxy for outbound LLM calls.
HTTP_PROXY=
HTTPS_PROXY=
# Set by the CI runner to the agent's full image ref; the tag after the final
# ":" becomes reviewer_version in analytics. Unset → dev
PR_AGENT_IMAGE=
